{
  "name": "theall-text",
  "version": "1.0.0-rc.1",
  "description": "TheAll_Text is a tool that lets you generate an image that looks like handwriting from text.",
  "main": "index.html",
  "scripts": {
    "test": "cypress run",
    "eslint": "eslint --fix \"js/**/**.mjs\"",
    "prettier": "prettier --write \"./index.html\" \"js/**/**.mjs\" \"css/**.css\"",
    "format": "npm run prettier",
    "cy": "cypress open",
    "dev": "serve ."
  },
  "devDependencies": {
    "cypress": "^4.4.1",
    "eslint": "^7.0.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-prettier": "^3.1.3",
    "husky": "^4.2.5",
    "prettier": "^2.0.5",
    "serve": "^11.3.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run prettier && eslint . --fix && npm run eslint"
    }
  }
}
